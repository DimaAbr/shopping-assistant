{
  "name": "shopping-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/adapters/http/contract.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "chat": "tsx src/adapters/cli/main.ts",
    "api": "tsx src/adapters/http/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "vitest run --config evals/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "web": "pnpm --filter shopping-web dev",
    "mcp-app": "pnpm --filter shopping-web build:mcp-app"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.159",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.35",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
