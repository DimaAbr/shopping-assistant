# Copy to .env and fill in. Loaded by src/config/env.ts (no dotenv needed).
OPENAI_API_KEY=

# Model per role (02 §2). All default to gpt-6-luna.
# MODEL_CHAT=gpt-6-luna
# MODEL_SUMMARIZER=gpt-6-luna
# MODEL_JUDGE=gpt-6-luna

# Tool-loop step limit per turn.
# MAX_STEPS=5

# Where step logs go (02 §12).
# STEP_LOG_PATH=logs/steps.jsonl

# Product catalog API (02 §5).
# DUMMYJSON_BASE_URL=https://dummyjson.com

# Chat storage (02 §6). A libsql URL; `file:` paths are relative to the working directory.
# DATABASE_URL=file:data/shopping.db

# HTTP API port (`pnpm api`, 07).
# PORT=3000
